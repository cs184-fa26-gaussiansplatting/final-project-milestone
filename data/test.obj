# test cube mesh with per-face materials (colored faces)
mtllib test.mtl
o cube

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

# front (+z) red
usemtl red
f 5 6 7
f 5 7 8
# back (-z) green
usemtl green
f 1 3 2
f 1 4 3
# right (+x) blue
usemtl blue
f 2 3 7
f 2 7 6
# left (-x) yellow
usemtl yellow
f 1 4 8
f 1 5 8
# top (+y) cyan
usemtl cyan
f 4 8 7
f 4 7 3
# bottom (-y) magenta
usemtl magenta
f 1 2 6
f 1 6 5
